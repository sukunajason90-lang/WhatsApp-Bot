# WhatsApp Bot Configuration
BOT_NAME=Canvas Bot
BOT_PREFIX=.
BOT_OWNER_NUMBER=212612345678  # Votre numéro WhatsApp avec indicatif pays

# OpenAI API Key (pour .gpt / .ai)
OPENAI_API_KEY=your_openai_key_here

# Google Gemini API Key (optionnel)
GEMINI_API_KEY=your_gemini_key_here

# YouTube API Key (pour .ytmp4 / .play)
YOUTUBE_API_KEY=your_youtube_key_here

# Spotify API (optionnel)
SPOTIFY_CLIENT_ID=your_spotify_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_secret_here

# Database
DATABASE_PATH=./database/bot.db

# Environment
NODE_ENV=production
DEBUG=false
